# MongoDB Atlas — get this from Atlas Dashboard > Connect > Drivers
# Free M0 cluster at https://cloud.mongodb.com
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/whattowatch?retryWrites=true&w=majority"

# OMDB API key — free at https://www.omdbapi.com/apikey.aspx (1000 req/day)
OMDB_API_KEY="your_omdb_api_key"

# A random string to protect the /api/sync and /api/enrich endpoints
# Generate with: openssl rand -hex 32
SYNC_SECRET="change_this_to_a_random_secret"

# Your app's public URL (used for fire-and-forget enrich call after sync)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

