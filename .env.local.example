# Vercel Postgres (Neon) — get these from Vercel Dashboard > Storage > Postgres
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# OMDB API key — free at https://www.omdbapi.com/apikey.aspx (1000 req/day)
OMDB_API_KEY="your_omdb_api_key"

# A random string to protect the /api/sync and /api/enrich endpoints
# Generate with: openssl rand -hex 32
SYNC_SECRET="change_this_to_a_random_secret"

# Your app's public URL (used for fire-and-forget enrich call after sync)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
