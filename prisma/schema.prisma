generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Title {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  jwId             String    @unique
  imdbId           String?
  title            String
  year             Int?
  type             String
  genres           String[]
  posterUrl        String?

  imdbRating       Float?
  rtScore          Int?
  metacritic       Int?
  plot             String?
  director         String?
  actors           String?
  runtime          String?
  rated            String?

  onNetflix        Boolean   @default(false)
  onPrime          Boolean   @default(false)
  onPrimePay       Boolean   @default(false)
  onDisney         Boolean   @default(false)
  onApple          Boolean   @default(false)
  onApplePay       Boolean   @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  ratingsUpdatedAt DateTime?

  @@index([type])
  @@index([rtScore])
  @@index([imdbRating])
  @@index([onNetflix, onPrime, onPrimePay, onDisney, onApple, onApplePay])
}

model SyncLog {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  status         String
  titlesSynced   Int       @default(0)
  titlesDeleted  Int?
  error          String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
}

// Singleton row (id = "singleton") tracking in-progress sync state across chained invocations
model SyncState {
  id           String   @id @map("_id")
  phase        String   // "providers" | "genres" | "complete"
  phaseIndex   Int
  cursor       String?  // JustWatch pagination cursor — set when a provider needs multiple steps
  genres       String[]
  syncLogId    String   @db.ObjectId
  titlesSynced Int
}
